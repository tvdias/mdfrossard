<!-- Delay Engine For Scripts (GTM & FB)
     Carrega no primeiro momento ocioso do navegador (requestIdleCallback),
     com teto de 3500ms. NÃO fica mais amarrado à primeira interação do
     usuário (scroll/click/touchstart/mousemove): rodar vários scripts de
     terceiros dentro do mesmo evento que o INP mede era o que estava
     inflando a métrica de Interactivity no CrUX. -->
<script>
(function() {
  var delayedFired = false;

  function fireDelayedScripts() {
    if (delayedFired) return;
    delayedFired = true;

    // Find all delayed scripts and execute them
    var scripts = document.querySelectorAll('script[type="text/delayed-script"]');
    for (var i = 0; i < scripts.length; i++) {
      var s = scripts[i];
      try {
        var newScript = document.createElement('script');
        newScript.type = 'text/javascript';

        if (s.hasAttribute('data-src')) {
            newScript.src = s.getAttribute('data-src');
            newScript.async = true;
        }
        if (s.textContent) {
            newScript.textContent = s.textContent;
        }

        document.body.appendChild(newScript);
      } catch(e) {
        if (typeof console !== 'undefined') console.warn('[delay-engine] script #' + i + ' error:', e);
      }

      // Keep DOM clean (optional)
      s.parentNode.removeChild(s);
    }
  }

  if ('requestIdleCallback' in window) {
    requestIdleCallback(fireDelayedScripts, {timeout: 3500});
  } else {
    // Safari antigo / navegadores sem requestIdleCallback
    setTimeout(fireDelayedScripts, 3500);
  }
})();
</script>
